---
import Icon from './Icon.astro';

interface Labels {
  light: string;
  dark: string;
}

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  id="theme-toggle"
  aria-label={labels.dark}
  title={labels.dark}
  data-labels={JSON.stringify(labels)}
>
  <span class="theme-toggle__icon theme-toggle__icon--sun">
    <Icon name="sun" size={19} />
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon">
    <Icon name="moon" size={19} />
  </span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--text);
    transition: background-color 0.25s ease, color 0.25s ease,
      transform 0.25s ease;
  }

  .theme-toggle:hover {
    background: var(--surface);
  }

  .theme-toggle:active {
    transform: scale(0.94);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    transition: opacity 0.3s ease, transform 0.35s ease;
  }

  .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(-35deg) scale(0.6);
  }

  :global(html[data-theme='dark']) .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(35deg) scale(0.6);
  }

  :global(html[data-theme='dark']) .theme-toggle__icon--moon {
    opacity: 1;
    transform: none;
  }
</style>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    if (!button) return;

    const labels = JSON.parse(button.dataset.labels || '{}');
    const root = document.documentElement;

    const sync = () => {
      const isDark = root.dataset.theme === 'dark';
      const nextLabel = isDark ? labels.light : labels.dark;
      if (nextLabel) {
        button.setAttribute('aria-label', nextLabel);
        button.setAttribute('title', nextLabel);
      }
      button.setAttribute('aria-pressed', String(isDark));
    };

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (error) {
        /* storage can be unavailable; theme still applies for this visit */
      }
      sync();
    });

    sync();
  })();
</script>
