---
interface Props {
  footer: {
    copyright: string;
    mark: string;
  };
}

const { footer } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">{footer.copyright}</p>
    <span class="site-footer__mark" aria-hidden="true">{footer.mark}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 26px;
  }

  .site-footer__copy {
    font-size: 13px;
    color: var(--text-faint);
  }

  .site-footer__mark {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.06em;
    color: var(--rust);
  }
</style>
