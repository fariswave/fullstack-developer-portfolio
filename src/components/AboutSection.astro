---
import Icon from './Icon.astro';

interface Props {
  about: {
    number: string;
    eyebrow: string;
    title: string;
    body: string;
    email: string;
  };
}

const { about } = Astro.props;
---

<section class="section about" id="about">
  <div class="container about__grid">
    <div class="about__lead reveal">
      <p class="eyebrow about__eyebrow">
        <span class="num">{about.number}</span>
        <span class="sep">/</span>
        <span>{about.eyebrow}</span>
      </p>
      <h2 class="about__title">{about.title}</h2>
    </div>

    <div class="about__body reveal" style="--reveal-delay: 80ms;">
      <p>{about.body}</p>
      <a class="btn btn--solid about__button" href={`mailto:${about.email}`}>
        <span>{about.email}</span>
        <Icon name="arrow-up-right" size={17} />
      </a>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .about__eyebrow {
    margin-bottom: clamp(22px, 3vw, 32px);
  }

  .about__title {
    font-size: clamp(30px, 3.35vw, 43px);
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .about__body p {
    font-size: 16px;
    line-height: 1.78;
    color: var(--text-soft);
    max-width: 62ch;
  }

  .about__button {
    margin-top: 30px;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .about__title {
      max-width: 18ch;
    }

    .about__eyebrow {
      margin-bottom: 16px;
    }

    .about__button {
      margin-top: 24px;
    }
  }

  @media (max-width: 560px) {
    .about__button {
      padding-inline: 16px;
      font-size: 13.5px;
    }
  }
</style>
