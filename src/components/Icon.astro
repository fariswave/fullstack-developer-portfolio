---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={def.viewBox}
  fill={def.filled ? 'currentColor' : 'none'}
  stroke={def.filled ? 'none' : 'currentColor'}
  stroke-width={def.filled ? undefined : stroke}
  stroke-linecap={def.filled ? undefined : 'round'}
  stroke-linejoin={def.filled ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
  set:html={def.inner}
/>