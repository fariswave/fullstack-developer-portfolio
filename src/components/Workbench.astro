---
import Icon from './Icon.astro';

interface Props {
  label: string;
  path: string;
  prompt: string;
  command: string;
}

const { label, path, prompt, command } = Astro.props;
---

<div class="workbench" aria-hidden="true">
  <div class="workbench__top">
    <span>{label}</span>
    <Icon name="asterisk" size={25} class="workbench__asterisk" />
  </div>

  <div class="workbench__mark" aria-hidden="true">{'{fk}'}</div>
  <div class="workbench__disc" aria-hidden="true"></div>

  <div class="workbench__snippet">
    <span class="workbench__path">{path}</span>
    <span class="workbench__command">
      <span class="workbench__prompt">{prompt}</span>
      <span>{command}</span>
    </span>
  </div>
</div>

<style>
  .workbench {
    position: relative;
    min-height: 400px;
    padding: 30px 34px;
    background: var(--workbench-bg);
    border-radius: 3px;
    overflow: hidden;
    isolation: isolate;
    transition: background-color 0.35s ease;
  }

  .workbench__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .workbench__top :global(.workbench__asterisk) {
    color: var(--rust);
    flex-shrink: 0;
  }

  .workbench__mark {
    position: relative;
    z-index: 1;
    margin-top: 46px;
    font-size: clamp(96px, 11vw, 150px);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: var(--text);
    user-select: none;
  }

  .workbench__disc {
    position: absolute;
    right: -64px;
    bottom: -86px;
    z-index: 0;
    width: 292px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--workbench-disc);
    transition: background-color 0.35s ease;
  }

  .workbench__snippet {
    position: absolute;
    z-index: 3;
    left: 48px;
    bottom: 52px;
    display: grid;
    gap: 3px;
    width: min(330px, calc(100% - 88px));
    padding: 15px 19px 17px;
    border-radius: 3px;
    background: var(--snippet-bg);
    color: var(--snippet-text);
    box-shadow: var(--shadow-snippet);
    transform: rotate(-1.4deg);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    transition: background-color 0.35s ease, color 0.35s ease;
  }

  .workbench__path {
    color: var(--text-faint);
    font-size: 11.5px;
  }

  .workbench__command {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
  }

  .workbench__prompt {
    color: var(--green);
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    .workbench {
      min-height: 380px;
      padding: 26px 28px;
    }

    .workbench__snippet {
      left: 32px;
      bottom: 40px;
    }
  }

  @media (max-width: 900px) {
    .workbench {
      min-height: 350px;
    }

    .workbench__mark {
      margin-top: 34px;
    }
  }

  @media (max-width: 560px) {
    .workbench {
      min-height: 330px;
      padding: 22px 22px;
    }

    .workbench__mark {
      margin-top: 30px;
      font-size: 96px;
    }

    .workbench__disc {
      width: 220px;
      right: -52px;
      bottom: -64px;
    }

    .workbench__snippet {
      left: 22px;
      bottom: 25px;
      width: calc(100% - 44px);
      padding: 12px 15px 14px;
      font-size: 11.5px;
    }

    .workbench__path {
      font-size: 10.5px;
      overflow-wrap: anywhere;
    }
  }
</style>
