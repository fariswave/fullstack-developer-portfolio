---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  education: {
    number: string;
    title: string;
    label: string;
    text: string;
  };
}

const { education } = Astro.props;
---

<section class="section" id="education">
  <div class="container">
    <SectionHeader
      number={education.number}
      title={education.title}
      label={education.label}
    />

    <div class="education__card reveal">
      <span class="education__icon" aria-hidden="true">
        <Icon name="cap" size={24} />
      </span>
      <p class="education__text">{education.text}</p>
    </div>
  </div>
</section>

<style>
  .education__card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 26px 30px;
    background: var(--surface);
    border-radius: 3px;
  }

  .education__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid var(--text);
    border-radius: 8px;
    color: var(--green);
  }

  .education__text {
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.4;
  }

  @media (max-width: 560px) {
    .education__card {
      padding: 20px;
      gap: 14px;
      align-items: flex-start;
    }

    .education__icon {
      width: 38px;
      height: 38px;
    }

    .education__text {
      font-size: 17px;
      padding-top: 3px;
    }
  }
</style>
