---
interface Props {
  number: string;
  title: string;
  label?: string;
}

const { number, title, label } = Astro.props;
---

<div class="section-head reveal">
  <span class="section-head__number num">{number}</span>
  <h2 class="section-head__title">{title}</h2>
  {label && <span class="section-head__label">{label}</span>}
</div>

<style>
  .section-head {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: start;
    gap: 0;
    margin-bottom: 44px;
  }

  .section-head__number {
    padding-top: 0.55em;
    font-size: 13px;
    font-weight: 500;
    color: var(--rust);
  }

  .section-head__title {
    font-size: clamp(30px, 3.45vw, 46px);
    letter-spacing: -0.035em;
    max-width: 22ch;
  }

  .section-head__label {
    padding-top: 0.7em;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .section-head {
      grid-template-columns: 38px 1fr;
      gap: 8px;
      margin-bottom: 30px;
    }

    .section-head__label {
      display: none;
    }

    .section-head__number {
      font-size: 12px;
    }
  }
</style>
