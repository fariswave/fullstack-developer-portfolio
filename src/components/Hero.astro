---
import Icon from './Icon.astro';
import Workbench from './Workbench.astro';

interface Props {
  hero: {
    eyebrow: string;
    firstName: string;
    lastName: string;
    title: string;
    workbenchLabel: string;
    path: string;
    prompt: string;
    command: string;
  };
}

const { hero } = Astro.props;
---

<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__copy reveal">
      <p class="hero__eyebrow">
        <Icon name="pin" size={15} />
        <span>{hero.eyebrow}</span>
      </p>

      <h1 class="hero__name">
        <span>{hero.firstName}</span>
        <span>{hero.lastName}</span>
      </h1>

      <p class="hero__role">
        <span class="hero__dash" aria-hidden="true"></span>
        <span>{hero.title}</span>
      </p>
    </div>

    <div class="hero__aside reveal" style="--reveal-delay: 90ms;">
      <Workbench
        label={hero.workbenchLabel}
        path={hero.path}
        prompt={hero.prompt}
        command={hero.command}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 62px 70px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    align-items: center;
    gap: clamp(38px, 5.5vw, 76px);
  }

  .hero__copy {
    padding-bottom: 6px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(26px, 4vw, 40px);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
  }

  .hero__eyebrow :global(.icon) {
    flex-shrink: 0;
  }

  .hero__name {
    display: flex;
    flex-direction: column;
    font-size: clamp(62px, 8.4vw, 108px);
    line-height: 0.93;
    letter-spacing: -0.055em;
    color: var(--text);
  }

  .hero__role {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: clamp(22px, 3vw, 32px);
    font-size: clamp(21px, 2.15vw, 27px);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--rust);
    line-height: 1.2;
  }

  .hero__dash {
    display: block;
    width: clamp(20px, 2.2vw, 30px);
    height: 1.5px;
    flex-shrink: 0;
    background: var(--rust);
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 46px 54px;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .hero__eyebrow {
      margin-bottom: 24px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-block: 36px 44px;
    }

    .hero__role {
      margin-top: 20px;
    }

    .hero__grid {
      gap: 30px;
    }
  }
</style>
